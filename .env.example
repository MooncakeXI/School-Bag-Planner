# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://sbp:sbp@localhost:5432/school_bag_planner"
TEST_DATABASE_URL="postgresql://sbp:sbp@localhost:5432/school_bag_test"

# `openssl rand -base64 33`
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret for POST /api/cron/reminders — an external scheduler
# (cron/hosting platform) must send `Authorization: Bearer <this>` at
# 18:30 and 20:00 Asia/Bangkok. `openssl rand -base64 33`
CRON_SECRET=""

# Where packing-scan photos are stored (lib/photo-storage.ts). "local"
# (default) writes to var/packing-photos/ on disk — fine for dev, but lost
# on every redeploy/serverless cold start, so not appropriate for anything
# meant to survive across a term. Set to "s3" for S3-compatible object
# storage (AWS S3, Cloudflare R2, or GCS's S3-interop mode) in any
# deployment that matters.
PHOTO_STORAGE_DRIVER="local"

# Required when PHOTO_STORAGE_DRIVER="s3".
PHOTO_STORAGE_BUCKET=""
# "auto" works for Cloudflare R2; set your real region for AWS S3/GCS.
PHOTO_STORAGE_REGION="auto"
# Required for R2/GCS (their S3-compatible API endpoint); leave unset for
# real AWS S3, which the SDK resolves from PHOTO_STORAGE_REGION instead.
PHOTO_STORAGE_ENDPOINT=""
PHOTO_STORAGE_ACCESS_KEY_ID=""
PHOTO_STORAGE_SECRET_ACCESS_KEY=""

# Sampling for the future CV training set (ARCHITECTURE.md §8.6): the
# fraction of consented scans that actually keep a photo once a
# (student, item) pair already has PHOTO_MIN_SAMPLES_PER_ITEM stored —
# below that floor, every scan is captured regardless of the rate, so
# coverage stays even across items instead of favoring whichever ones get
# scanned most often.
PHOTO_SAMPLE_RATE="0.1"
PHOTO_MIN_SAMPLES_PER_ITEM="5"
